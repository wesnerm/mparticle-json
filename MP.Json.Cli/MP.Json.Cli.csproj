<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MP.Json.Cli</RootNamespace>
    <AssemblyName>mpjson</AssemblyName>
    <Nullable>disable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mpjson</ToolCommandName>
    <PackageId>MP.Json.Cli</PackageId>
    <Version>1.0.0.0</Version>
    <Authors>Wesner Moise</Authors>
    <Company>mParticle, Inc</Company>
    <Product>MP.Json.Validation</Product>
    <Description>Command-line JSON Schema validator built on MP.Json.Validation</Description>
    <Copyright>Copyright (c) 2020, mParticle, Inc</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mParticle/mparticle-json</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mParticle/mparticle-json</RepositoryUrl>
    <PackageTags>JSON Schema;CLI</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MP.Json.Validation\MP.Json.Validation.csproj" />
  </ItemGroup>

</Project>
